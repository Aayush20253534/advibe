# AdVibe is backend-only. No demo mode exists in runtime routing.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_INDEXING_ENABLED=false

# Server-side Next.js relay to Express. Do not use NEXT_PUBLIC_ for this value.
# Local development: http://127.0.0.1:4000
# Production: a verified HTTPS origin belonging to your deployed API.
ADVIBE_BACKEND_ORIGIN=http://127.0.0.1:4000

# Backend API must be configured separately: DATABASE_URL, DIRECT_URL,
# authentication/MFA secrets, CORS_ORIGINS, AUTH_WEB_ORIGIN and verified email.
# Payment/payout/device feature flags remain disabled until explicitly approved.
