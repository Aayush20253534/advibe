# AdVibe is backend-only. No demo mode exists in runtime routing.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_INDEXING_ENABLED=false

# Server-side Next.js relay to Express. Do not use NEXT_PUBLIC_ for this value.
# Local development: http://127.0.0.1:4000
# Production: a verified HTTPS origin belonging to your deployed API.
ADVIBE_BACKEND_ORIGIN=http://127.0.0.1:4000

# Cloudflare Turnstile public site key (safe to expose). Enables backend POST /enquiries.
# Backend must separately configure ENQUIRY_TURNSTILE_SECRET and ENQUIRY_TURNSTILE_HOSTNAME.
# Without this key, the public contact page opens the user's email app instead.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_public_turnstile_site_key

# Backend API must be configured separately: DATABASE_URL, DIRECT_URL,
# authentication/MFA secrets, CORS_ORIGINS, AUTH_WEB_ORIGIN and verified email.
# Payment/payout/device feature flags remain disabled until explicitly approved.

# Disabled by default; no Google key is required or used until this is true.
# NEXT_PUBLIC values are compiled into the frontend: rebuild/redeploy after changing.
NEXT_PUBLIC_GOOGLE_MAPS_ENABLED=false
# When enabled, supply a public Maps Embed API browser key. Restrict to approved HTTPS referrers
# and the Maps Embed API only. No server geocoding key is used by this map layer.
# Map requests happen only after the visitor selects Load Google Maps.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=your_restricted_browser_key

# Optional interactive published zone boundaries. Maps JavaScript API (Dynamic Maps) may be billed.
# Disabled by default; existing free Embed map remains available if disabled.
# Requires Google Cloud Maps JavaScript API enabled and a separate browser key restricted
# to this API and the approved HTTP referrers. NEXT_PUBLIC_GOOGLE_MAPS_ENABLED must also be true.
# The map script loads only after the visitor clicks Load Google Maps.
NEXT_PUBLIC_GOOGLE_MAPS_COVERAGE_ENABLED=false
# NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=your_maps_javascript_api_restricted_browser_key
